#!/usr/bin/env bash
# Manages the manage_my_process script: start, stop, restart.

PID_FILE="/var/run/my_process.pid"
PROCESS_SCRIPT="./manage_my_process"

start() {
    [ -f "$PID_FILE" ] && { echo "Already running."; exit 1; }
    $PROCESS_SCRIPT & echo $! > "$PID_FILE"
    echo "Started."
}

stop() {
    [ ! -f "$PID_FILE" ] && { echo "Not running."; exit 1; }
    kill "$(cat $PID_FILE)" && rm -f "$PID_FILE"
    echo "Stopped."
}

restart() {
    stop; start; echo "Restarted."
}

case "$1" in
    start) start ;;
    stop) stop ;;
    restart) restart ;;
    *) echo "Usage: manage_my_process {start|stop|restart}" ;;
esac
