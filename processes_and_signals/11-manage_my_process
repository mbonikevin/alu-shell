#!/usr/bin/env bash
# my process managment

start () {
    if [ ! -f /var/run/my_process.pid ]; then
        ./manage_my_process &
        echo $! > /var/run/my_process.pid
        echo "manage_my_process started"               

        # Check if the process is running
        if ps -p $(cat /var/run/my_process.pid) > /dev/null; then
            echo "manage_my_process is running."
        else
            echo "Failed to start manage_my_process."
        fi
    else
        echo "manage_my_process is already running."
    fi
}

stop () {
    if [ -f /var/run/my_process.pid ]; then
        pkill -F /var/run/my_process.pid
        rm -f /var/run/my_process.pid
        echo "manage_my_process stopped"               
    else
        echo "PID file does not exist. Process may not be running."
    fi
}

restart () {
    if [ -f /var/run/my_process.pid ]; then
        pkill -F /var/run/my_process.pid
        rm -f /var/run/my_process.pid
    fi
    ./manage_my_process &
    echo $! > /var/run/my_process.pid
    echo "manage_my_process restarted"             

    # Check if the process is running
    if ps -p $(cat /var/run/my_process.pid) > /dev/null; then
        echo "manage_my_process is running."
    else
        echo "Failed to start manage_my_process."
    fi
}

case "$1" in
  start) start ;;
  stop)  stop ;;
  restart) restart ;;
  *) echo "Usage: manage_my_process {start|stop|restart}"                                           
     ;;
esac
